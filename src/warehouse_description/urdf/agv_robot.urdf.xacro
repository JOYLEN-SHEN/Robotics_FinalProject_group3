<?xml version="1.0"?>
<!--
  AGV Robot URDF/Xacro Model
  Differential drive robot with:
    - 2 active drive wheels + 2 caster wheels
    - 2D LiDAR (360 deg, 12m range)
    - RGB Camera (640x480)
    - IMU
    - Wheel encoders (odometry)
  Dimensions: 60cm x 40cm x 30cm
-->
<robot name="agv_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PROPERTIES ==================== -->
  <xacro:arg name="robot_name" default="robot_1"/>
  <xacro:arg name="robot_namespace" default="robot_1"/>

  <xacro:property name="robot_name"      value="$(arg robot_name)"/>
  <xacro:property name="ns"             value="$(arg robot_namespace)"/>

  <!-- Body dimensions -->
  <xacro:property name="base_length"    value="0.60"/>
  <xacro:property name="base_width"     value="0.40"/>
  <xacro:property name="base_height"    value="0.20"/>
  <xacro:property name="base_mass"      value="30.0"/>

  <!-- Wheel properties -->
  <xacro:property name="wheel_radius"   value="0.08"/>
  <xacro:property name="wheel_width"    value="0.05"/>
  <xacro:property name="wheel_mass"     value="1.5"/>
  <xacro:property name="wheel_y_offset" value="0.225"/>
  <xacro:property name="wheel_z_offset" value="0.0"/>

  <!-- Caster properties -->
  <xacro:property name="caster_radius"  value="0.04"/>
  <xacro:property name="caster_mass"    value="0.5"/>

  <!-- Sensor heights -->
  <xacro:property name="lidar_height"   value="0.22"/>
  <xacro:property name="camera_height"  value="0.18"/>
  <xacro:property name="imu_height"     value="0.12"/>

  <!-- Inertia macros -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== BASE LINK ==================== -->
  <link name="${ns}/base_footprint"/>

  <joint name="${ns}/base_footprint_joint" type="fixed">
    <parent link="${ns}/base_link"/>
    <child  link="${ns}/base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="${ns}/base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="agv_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- ==================== DRIVE WHEELS ==================== -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${ns}/${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${ns}/${prefix}_wheel_joint" type="continuous">
      <parent link="${ns}/base_link"/>
      <child  link="${ns}/${prefix}_wheel_link"/>
      <origin xyz="0 ${y_reflect * wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  y_reflect="1"/>
  <xacro:drive_wheel prefix="right" y_reflect="-1"/>

  <!-- ==================== CASTER WHEELS ==================== -->
  <xacro:macro name="caster_wheel" params="prefix x_pos y_pos">
    <!-- Swivel link -->
    <link name="${ns}/${prefix}_caster_swivel">
      <xacro:sphere_inertia m="0.01" r="0.01"/>
    </link>
    <joint name="${ns}/${prefix}_caster_swivel_joint" type="continuous">
      <parent link="${ns}/base_link"/>
      <child  link="${ns}/${prefix}_caster_swivel"/>
      <origin xyz="${x_pos} ${y_pos} ${-wheel_radius + caster_radius}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Caster wheel -->
    <link name="${ns}/${prefix}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="caster_gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>
    <joint name="${ns}/${prefix}_caster_joint" type="continuous">
      <parent link="${ns}/${prefix}_caster_swivel"/>
      <child  link="${ns}/${prefix}_caster_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:caster_wheel prefix="front_left"  x_pos=" 0.22" y_pos=" 0.15"/>
  <xacro:caster_wheel prefix="front_right" x_pos=" 0.22" y_pos="-0.15"/>
  <xacro:caster_wheel prefix="rear_left"   x_pos="-0.22" y_pos=" 0.15"/>
  <xacro:caster_wheel prefix="rear_right"  x_pos="-0.22" y_pos="-0.15"/>

  <!-- ==================== 2D LIDAR ==================== -->
  <link name="${ns}/lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="${ns}/lidar_joint" type="fixed">
    <parent link="${ns}/base_link"/>
    <child  link="${ns}/lidar_link"/>
    <origin xyz="0 0 ${lidar_height}" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR Gazebo plugin -->
  <gazebo reference="${ns}/lidar_link">
    <sensor name="${ns}_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="${ns}_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>${ns}</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>${ns}/lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== RGB CAMERA ==================== -->
  <link name="${ns}/camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.04"/>
      </geometry>
      <material name="camera_dark">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="${ns}/camera_joint" type="fixed">
    <parent link="${ns}/base_link"/>
    <child  link="${ns}/camera_link"/>
    <origin xyz="${base_length/2 - 0.02} 0 ${camera_height}" rpy="0 0 0"/>
  </joint>

  <link name="${ns}/camera_optical_link"/>
  <joint name="${ns}/camera_optical_joint" type="fixed">
    <parent link="${ns}/camera_link"/>
    <child  link="${ns}/camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Camera Gazebo plugin -->
  <gazebo reference="${ns}/camera_link">
    <sensor name="${ns}_camera" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="${ns}_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>${ns}</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>${ns}_camera</camera_name>
        <frame_name>${ns}/camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== IMU ==================== -->
  <link name="${ns}/imu_link">
    <visual>
      <geometry><box size="0.03 0.03 0.01"/></geometry>
      <material name="imu_green"><color rgba="0.0 0.8 0.0 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="${ns}/imu_joint" type="fixed">
    <parent link="${ns}/base_link"/>
    <child  link="${ns}/imu_link"/>
    <origin xyz="0 0 ${imu_height}" rpy="0 0 0"/>
  </joint>

  <!-- IMU Gazebo plugin -->
  <gazebo reference="${ns}/imu_link">
    <sensor name="${ns}_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="${ns}_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>${ns}</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>${ns}/imu_link</frame_name>
      </plugin>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==================== DIFF DRIVE PLUGIN ==================== -->
  <gazebo>
    <plugin name="${ns}_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>${ns}</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
        <!-- Remap absolute /tf → relative tf so TF lands in /${ns}/tf
             (nav2 nodes subscribe to /${ns}/tf via their own '/tf'→'tf' remapping) -->
        <remapping>/tf:=tf</remapping>
      </ros>
      <left_joint>${ns}/left_wheel_joint</left_joint>
      <right_joint>${ns}/right_wheel_joint</right_joint>
      <wheel_separation>${2 * wheel_y_offset}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>${ns}/odom</odometry_frame>
      <robot_base_frame>${ns}/base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Gazebo surface properties: drive wheels need high friction for traction -->
  <gazebo reference="${ns}/left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="${ns}/right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- Publish caster joint states so RSP can broadcast their TF frames.
       diff_drive only covers left/right wheel joints; casters are passive. -->
  <gazebo>
    <plugin name="${ns}_caster_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>${ns}</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>${ns}/front_left_caster_swivel_joint</joint_name>
      <joint_name>${ns}/front_left_caster_joint</joint_name>
      <joint_name>${ns}/front_right_caster_swivel_joint</joint_name>
      <joint_name>${ns}/front_right_caster_joint</joint_name>
      <joint_name>${ns}/rear_left_caster_swivel_joint</joint_name>
      <joint_name>${ns}/rear_left_caster_joint</joint_name>
      <joint_name>${ns}/rear_right_caster_swivel_joint</joint_name>
      <joint_name>${ns}/rear_right_caster_joint</joint_name>
      <joint_name>${ns}/left_wheel_joint</joint_name>
      <joint_name>${ns}/right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Caster wheels: low friction so they roll/swivel freely -->
  <gazebo reference="${ns}/front_left_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="${ns}/front_right_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="${ns}/rear_left_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="${ns}/rear_right_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- Base link color in Gazebo -->
  <gazebo reference="${ns}/base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
