<?xml version="1.0"?>
<!--
  Warehouse Gazebo World
  Layout: 30m x 20m enclosed warehouse
  - 4 shelf rows (5 shelves each), corridor width: 2.5m
  - 2 loading docks (west wall)
  - 2 unloading docks (east wall)
  - 4 charging stations (corners)
  - Structural columns
-->
<sdf version="1.6">
  <world name="warehouse_world">

    <!-- Physics engine -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Scene settings -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Additional ceiling lights -->
    <light name="ceiling_light_1" type="point">
      <pose>0 0 9 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <range>15</range>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="ceiling_light_2" type="point">
      <pose>10 0 9 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <range>15</range>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="ceiling_light_3" type="point">
      <pose>-10 0 9 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <range>15</range>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ==================== FLOOR ==================== -->
    <model name="warehouse_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="floor">
        <collision name="floor_collision">
          <geometry>
            <box><size>32 22 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box><size>32 22 0.1</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== OUTER WALLS ==================== -->
    <!-- North wall (y=+11) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 11 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>32 0.2 3.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>32 0.2 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- South wall (y=-11) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -11 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>32 0.2 3.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>32 0.2 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- East wall (x=+16) - with unloading dock openings -->
    <model name="wall_east_upper">
      <static>true</static>
      <pose>16 6 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.2 10 3.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 10 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_east_lower">
      <static>true</static>
      <pose>16 -6 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.2 10 3.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 10 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- West wall (x=-16) - with loading dock openings -->
    <model name="wall_west_upper">
      <static>true</static>
      <pose>-16 6 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.2 10 3.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 10 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_west_lower">
      <static>true</static>
      <pose>-16 -6 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.2 10 3.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 10 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ==================== SHELF ROWS ==================== -->
    <!--
      4 shelf rows, each row has 5 shelves
      Row positions (x): -10, -4, 4, 10
      Shelf positions along y: -8, -4, 0, 4, 8
      Shelf dimensions: 1.0m wide x 0.5m deep x 2.0m tall
      Corridors between rows: 2.5m wide
    -->
    <xacro:macro xmlns:xacro="http://www.ros.org/wiki/xacro" name="shelf_unit" params="name x y">
      <!-- This is just for world SDF; shelves are duplicated below -->
    </xacro:macro>

    <!-- Row 1: x = -10 -->
    <model name="shelf_r1_s1"><static>true</static><pose>-10 -8 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r1_s2"><static>true</static><pose>-10 -4 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r1_s3"><static>true</static><pose>-10  0 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r1_s4"><static>true</static><pose>-10  4 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r1_s5"><static>true</static><pose>-10  8 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>

    <!-- Row 2: x = -4 -->
    <model name="shelf_r2_s1"><static>true</static><pose>-4 -8 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r2_s2"><static>true</static><pose>-4 -4 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r2_s3"><static>true</static><pose>-4  0 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r2_s4"><static>true</static><pose>-4  4 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r2_s5"><static>true</static><pose>-4  8 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>

    <!-- Row 3: x = 4 -->
    <model name="shelf_r3_s1"><static>true</static><pose>4 -8 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r3_s2"><static>true</static><pose>4 -4 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r3_s3"><static>true</static><pose>4  0 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r3_s4"><static>true</static><pose>4  4 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r3_s5"><static>true</static><pose>4  8 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>

    <!-- Row 4: x = 10 -->
    <model name="shelf_r4_s1"><static>true</static><pose>10 -8 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r4_s2"><static>true</static><pose>10 -4 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r4_s3"><static>true</static><pose>10  0 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r4_s4"><static>true</static><pose>10  4 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="shelf_r4_s5"><static>true</static><pose>10  8 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 2.0</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link></model>

    <!-- ==================== LOADING DOCKS (West, x=-14) ==================== -->
    <model name="loading_dock_1">
      <static>true</static>
      <pose>-14 3 0.15 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.0 2.0 0.3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.0 2.0 0.3</size></box></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <model name="loading_dock_2">
      <static>true</static>
      <pose>-14 -3 0.15 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.0 2.0 0.3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.0 2.0 0.3</size></box></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ==================== UNLOADING DOCKS (East, x=+14) ==================== -->
    <model name="unloading_dock_1">
      <static>true</static>
      <pose>14 3 0.15 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.0 2.0 0.3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.0 2.0 0.3</size></box></geometry>
          <material><script><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <model name="unloading_dock_2">
      <static>true</static>
      <pose>14 -3 0.15 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.0 2.0 0.3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.0 2.0 0.3</size></box></geometry>
          <material><script><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ==================== CHARGING STATIONS (Corners) ==================== -->
    <model name="charging_station_1">
      <static>true</static>
      <pose>-13 9 0.05 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 1.5 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 1.5 0.1</size></box></geometry>
          <material><script><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <model name="charging_station_2">
      <static>true</static>
      <pose>13 9 0.05 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 1.5 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 1.5 0.1</size></box></geometry>
          <material><script><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <model name="charging_station_3">
      <static>true</static>
      <pose>-13 -9 0.05 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 1.5 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 1.5 0.1</size></box></geometry>
          <material><script><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <model name="charging_station_4">
      <static>true</static>
      <pose>13 -9 0.05 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 1.5 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 1.5 0.1</size></box></geometry>
          <material><script><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ==================== STRUCTURAL COLUMNS ==================== -->
    <model name="column_1"><static>true</static><pose>-7  10 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry><material><script><name>Gazebo/Grey</name></script></material></visual></link></model>
    <model name="column_2"><static>true</static><pose> 0  10 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry><material><script><name>Gazebo/Grey</name></script></material></visual></link></model>
    <model name="column_3"><static>true</static><pose> 7  10 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry><material><script><name>Gazebo/Grey</name></script></material></visual></link></model>
    <model name="column_4"><static>true</static><pose>-7 -10 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry><material><script><name>Gazebo/Grey</name></script></material></visual></link></model>
    <model name="column_5"><static>true</static><pose> 0 -10 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry><material><script><name>Gazebo/Grey</name></script></material></visual></link></model>
    <model name="column_6"><static>true</static><pose> 7 -10 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry><material><script><name>Gazebo/Grey</name></script></material></visual></link></model>

    <!-- ==================== GUI SETTINGS ==================== -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -30 25 0 0.6 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
